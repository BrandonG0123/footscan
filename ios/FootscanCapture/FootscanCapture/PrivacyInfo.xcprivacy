<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's privacy manifest, which the App Store requires.
  - No tracking, and no data collected: scans stay on the phone unless the person sends them to a
    studio they connected themselves. Nothing reaches the app's developer or anyone else.
  - "Required reason" APIs the app calls, each with the one reason that fits:
      UserDefaults   CA92.1  the app's own settings (AppSettings.swift, @AppStorage in HomeView.swift, StudioStore)
      file dates     C617.1  creation dates of the scan's own files, in the app's container (ScanStore.swift)
      free space     E174.1  checks there is room to write a scan before capture starts (KeepAlive.swift)
                     85F4.1  and, when there isn't, tells the person how much is free
  tests/test_privacy_manifest.py checks this list against the Swift code, so a new use can't slip in undeclared.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
				<string>85F4.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
